# OpenClaw runtime data (config/* allows negation of specific files)
config/*
!config/openclaw.json.example
workspace/
.runtime/
.env.instance.local
.env.secrets.local

# Extension runtime config (user-specific, not tracked)
extensions/*/config.json

# Secrets
.env
.env.*
!.env.secrets.example
!.env.instance.local.example
!.env.secrets.local.example
*.key
*.pem

# Logs
*.log
logs/

# OS
.DS_Store

# Editors/IDEs
*.swp
*.swo
.idea/
.vscode/

# Node
node_modules/

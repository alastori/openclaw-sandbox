# Non-secret metadata for the current secret backend reference format.
# Override these in your shell or in `.env.secrets.local` if you use different names.
OP_VAULT=AI-Agents
OP_ITEM=OpenClaw Sandbox

# Hosted provider API keys for the container environment.
ANTHROPIC_API_KEY=op://${OP_VAULT}/${OP_ITEM}/anthropic_api_key
GEMINI_API_KEY=op://${OP_VAULT}/${OP_ITEM}/gemini_api_key
OPENAI_API_KEY=op://${OP_VAULT}/${OP_ITEM}/openai_api_key

# OpenClaw runtime secrets.
OPENCLAW_GATEWAY_TOKEN=op://${OP_VAULT}/${OP_ITEM}/gateway_token
TELEGRAM_BOT_TOKEN=op://${OP_VAULT}/${OP_ITEM}/telegram_bot_token

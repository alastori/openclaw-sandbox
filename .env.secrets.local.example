# Local-only bootstrap config for the current secret backend.
# Copy to `.env.secrets.local` and keep it untracked.
# Per-checkout port and Compose project settings live in `.env.instance.local`.

OP_SERVICE_ACCOUNT_TOKEN=ops_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional overrides if your vault or item names differ from `.env.secrets.example`.
# OP_VAULT=AI-Agents
# OP_ITEM=OpenClaw Sandbox

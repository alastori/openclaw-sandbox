{
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://host.docker.internal:11434/v1",
        "apiKey": "ollama",
        "api": "openai-completions",
        "models": [
          {
            "id": "gemma4:26b-a4b-it-q8_0",
            "name": "Gemma 4 26B MoE Q8",
            "contextWindow": 65536
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "contextTokens": 50000,
      "model": {
        "primary": "ollama/gemma4:26b-a4b-it-q8_0"
      },
      "compaction": {
        "mode": "safeguard"
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "controlUi": { "enabled": true },
    "auth": {
      "mode": "token",
      "rateLimit": { "maxAttempts": 10, "windowMs": 60000, "lockoutMs": 300000 }
    }
  },
  "tools": {
    "web": {
      "search": { "enabled": false },
      "fetch": { "enabled": true, "maxChars": 30000 }
    },
    "elevated": { "enabled": false },
    "exec": { "timeoutSec": 120 },
    "loopDetection": { "enabled": true }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  },
  "logging": {
    "redactSensitive": "tools"
  },
  "discovery": {
    "mdns": { "mode": "off" }
  }
}

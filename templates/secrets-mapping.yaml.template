# Secrets Mapping: connects tool/platform secret needs to your backend.
#
# Copy to config/secrets-mapping.yaml and fill in your refs.
# This file is gitignored — your refs are private.
#
# Backend options: 1password, vault, aws-sm, keychain, env
# See defaults/secrets-backend.json for backend definitions.

backend: 1password

# 1Password-specific settings (ignored if backend != 1password)
onepassword:
  vault: AI-Agents
  service_account_keychain: op-sa-alastori-sandbox

# Platform secrets (required)
platform:
  gateway-token:
    description: "OpenClaw gateway authentication token"
    required: true
    ref: "op://AI-Agents/OpenClaw Sandbox/gateway_token"
    env_fallback: OPENCLAW_GATEWAY_TOKEN

  telegram-bot-token:
    description: "Telegram bot token (skip if using Feishu only)"
    required: false
    ref: "op://AI-Agents/OpenClaw Sandbox/telegram_bot_token"
    env_fallback: TELEGRAM_BOT_TOKEN

# Model provider secrets
providers:
  anthropic-api-key:
    description: "Anthropic API key (pay-per-token)"
    required: false
    ref: "op://AI-Agents/OpenClaw Sandbox/anthropic_api_key"
    env_fallback: ANTHROPIC_API_KEY

  gemini-api-key:
    description: "Google Gemini API key"
    required: false
    ref: "op://AI-Agents/OpenClaw Sandbox/gemini_api_key"
    env_fallback: GEMINI_API_KEY

  openai-api-key:
    description: "OpenAI API key (pay-per-token)"
    required: false
    ref: "op://AI-Agents/OpenClaw Sandbox/openai_api_key"
    env_fallback: OPENAI_API_KEY


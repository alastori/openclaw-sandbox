{
  "meta": {
    "lastTouchedVersion": "2026.3.8"
  },
  "logging": {
    "redactSensitive": "tools"
  },
  "auth": {
    "profiles": {
      "github-copilot:github": {
        "provider": "github-copilot",
        "mode": "token"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "ollama": {
        "baseUrl": "http://host.docker.internal:11434/v1",
        "apiKey": "ollama",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen3.6:35b-a3b-q8_0",
            "name": "Qwen 3.6 35B A3B Q8",
            "contextWindow": 65536
          },
          {
            "id": "nemotron-3-super:120b-a12b-q4_K_M",
            "name": "Nemotron 3 Super (120B A12B)",
            "contextWindow": 65536
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "google/gemini-2.5-flash",
        "fallbacks": [
          "openai-codex/gpt-5.4",
          "openai/gpt-5.4",
          "anthropic/claude-sonnet-4-6",
          "anthropic/claude-opus-4-6",
          "ollama/qwen3.6:35b-a3b-q8_0",
          "ollama/nemotron-3-super:120b-a12b-q4_K_M"
        ]
      },
      "models": {
        "google/gemini-2.5-flash": {
          "alias": "Gemini 2.5 Flash"
        },
        "anthropic/claude-sonnet-4-6": {
          "alias": "Sonnet 4.6",
          "params": {
            "cacheRetention": "short"
          }
        },
        "anthropic/claude-opus-4-6": {
          "alias": "Opus 4.6",
          "params": {
            "cacheRetention": "short"
          }
        },
        "openai-codex/gpt-5.4": {
          "alias": "GPT-5.4 Codex"
        },
        "openai/gpt-5.4": {
          "alias": "GPT-5.4 API"
        },
        "ollama/qwen3.6:35b-a3b-q8_0": {
          "alias": "Qwen 3.6 Local"
        },
        "ollama/nemotron-3-super:120b-a12b-q4_K_M": {
          "alias": "Nemotron 3 Super Local"
        },
        "github-copilot/gpt-4o": {
          "alias": "Copilot GPT-4o"
        }
      },
      "contextTokens": 50000,
      "compaction": {
        "mode": "safeguard"
      }
    }
  },
  "skills": {
    "load": {
      "extraDirs": ["/home/node/skills"]
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true
      },
      "fetch": {
        "enabled": true,
        "maxChars": 30000
      }
    },
    "loopDetection": {
      "enabled": true
    },
    "elevated": {
      "enabled": false
    },
    "exec": {
      "timeoutSec": 120
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "channels": {
    "telegram": {
      "name": "${TELEGRAM_BOT_NAME}",
      "enabled": true,
      "dmPolicy": "pairing",
      "botToken": "op://${OP_VAULT}/${OP_ITEM}/telegram_bot_token",
      "groupPolicy": "open",
      "groups": {
        "*": { "requireMention": false }
      },
      "streaming": "off"
    }
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "gateway": {
    "port": ${OPENCLAW_PORT},
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "http://localhost:${OPENCLAW_PORT}",
        "http://127.0.0.1:${OPENCLAW_PORT}"
      ]
    },
    "auth": {
      "mode": "token",
      "token": "op://${OP_VAULT}/${OP_ITEM}/gateway_token"
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "copilot-proxy": {
        "enabled": true
      }
    }
  }
}

{
  "$comment": "Pluggable credential backend definitions. The active backend is selected per-user in config/secrets-mapping.yaml. Tool packs declare what they need; this file defines how to resolve it.",
  "backends": {
    "1password": {
      "source": "exec",
      "command": "op",
      "description": "1Password CLI via service account or biometric auth",
      "resolve_command": ["op", "read", "{ref}"],
      "batch_command": ["op", "run", "--env-file", "{env_file}"],
      "env_required": ["OP_SERVICE_ACCOUNT_TOKEN"],
      "setup": "brew install 1password-cli && op signin"
    },
    "vault": {
      "source": "exec",
      "command": "vault",
      "description": "HashiCorp Vault KV store",
      "resolve_command": ["vault", "kv", "get", "-field={field}", "{path}"],
      "env_required": ["VAULT_ADDR", "VAULT_TOKEN"],
      "setup": "brew install vault && vault login"
    },
    "aws-sm": {
      "source": "exec",
      "command": "aws",
      "description": "AWS Secrets Manager",
      "resolve_command": ["aws", "secretsmanager", "get-secret-value", "--secret-id", "{ref}", "--query", "SecretString", "--output", "text"],
      "env_required": ["AWS_REGION"],
      "setup": "brew install awscli && aws configure"
    },
    "keychain": {
      "source": "exec",
      "command": "security",
      "description": "macOS Keychain (local, no external service)",
      "resolve_command": ["security", "find-generic-password", "-a", "{account}", "-s", "{service}", "-w"],
      "env_required": [],
      "setup": "Built into macOS. Use: security add-generic-password -a <account> -s <service> -w <secret>"
    },
    "env": {
      "source": "env",
      "command": null,
      "description": "Environment variables only (simplest, least secure)",
      "resolve_command": null,
      "env_required": [],
      "setup": "Set env vars in .env.secrets.local or export manually"
    }
  },
  "default": "1password"
}

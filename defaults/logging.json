{
  "$comment": "Enforced logging defaults. Merged into openclaw.json at deploy time.",
  "logging": {
    "level": "info",
    "consoleLevel": "info",
    "consoleStyle": "compact",
    "file": "/home/node/.openclaw/logs/openclaw.log",
    "redactSensitive": "tools",
    "redactPatterns": [
      "sk-ant-[a-zA-Z0-9_-]+",
      "sk-[a-zA-Z0-9_-]{20,}",
      "AIzaSy[a-zA-Z0-9_-]+",
      "ghp_[a-zA-Z0-9]{36,}",
      "gho_[a-zA-Z0-9]{36,}",
      "xoxb-[a-zA-Z0-9-]+",
      "xoxp-[a-zA-Z0-9-]+",
      "\\b[0-9]{9,11}:[A-Za-z0-9_-]{35}\\b",
      "\\b[0-9]{3}-[0-9]{2}-[0-9]{4}\\b",
      "\\b[0-9]{4}[- ]?[0-9]{4}[- ]?[0-9]{4}[- ]?[0-9]{4}\\b"
    ]
  }
}

{
  "version": 1,
  "defaults": {
    "primary": {
      "provider": "google",
      "pinned": "google/gemini-2.5-flash",
      "alias": "Gemini 2.5 Flash",
      "familyRegex": "^gemini-2\\.5-flash",
      "adopt": "notify"
    },
    "fallbacks": [
      {
        "provider": "openai-codex",
        "pinned": "openai-codex/gpt-5.5",
        "alias": "GPT-5.5 Codex",
        "familyRegex": "^gpt-5(?:\\.(\\d+))?$",
        "adopt": "notify"
      },
      {
        "provider": "openai",
        "pinned": "openai/gpt-5.4",
        "alias": "GPT-5.4 API",
        "familyRegex": "^gpt-5(?:\\.(\\d+))?$",
        "adopt": "notify"
      },
      {
        "provider": "anthropic",
        "pinned": "anthropic/claude-sonnet-4-6",
        "alias": "Sonnet 4.6",
        "familyRegex": "^claude-sonnet-4",
        "adopt": "notify"
      },
      {
        "provider": "anthropic",
        "pinned": "anthropic/claude-opus-4-7",
        "alias": "Opus 4.7",
        "familyRegex": "^claude-opus-4",
        "adopt": "manual"
      },
      {
        "provider": "ollama",
        "pinned": "ollama/qwen3.6:35b-a3b-q8_0",
        "alias": "Qwen 3.6 Local",
        "familyRegex": "^qwen3\\.6",
        "adopt": "manual"
      },
      {
        "provider": "ollama",
        "pinned": "ollama/nemotron-3-super:120b-a12b-q4_K_M",
        "alias": "Nemotron 3 Super Local",
        "familyRegex": "^nemotron-3",
        "adopt": "manual"
      }
    ]
  }
}

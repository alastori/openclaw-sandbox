# Local-only instance settings for this checkout.
# Copy to `.env.instance.local` when you want multiple checkouts running in parallel.

# Compose project name. Set a unique value per checkout if you run multiple instances.
COMPOSE_PROJECT_NAME=openclaw-sandbox

# Gateway port exposed on localhost and used in the rendered OpenClaw config.
OPENCLAW_PORT=18789

# Telegram bot username (from @BotFather, without the @ prefix).
TELEGRAM_BOT_NAME=my_openclaw_bot

# Telegram group ID for topic-based conversations (from setup-telegram-topics.sh).
# Leave empty if using DM-only mode. When set, scripts/render-secrets-up.sh adds
# it to channels.telegram.groups and switches groupPolicy to "allowlist".
TELEGRAM_GROUP_ID=

# Comma-separated Telegram user IDs allowed to message the bot in any allowed
# group (channels.telegram.groupAllowFrom). Required for the bot to actually
# respond once TELEGRAM_GROUP_ID is set; an empty list with groupPolicy:
# "allowlist" drops every group message. Leave empty for DM-only deploys.
TELEGRAM_ALLOW_FROM=
